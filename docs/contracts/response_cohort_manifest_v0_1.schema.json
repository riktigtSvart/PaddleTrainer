{
  "$defs": {
    "DatasetSplitAssignment": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "POLAR",
          "title": "Provider",
          "type": "string"
        },
        "athlete_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Athlete Id",
          "type": "string"
        },
        "session_external_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Session External Id",
          "type": "string"
        },
        "split": {
          "enum": [
            "TRAIN",
            "VALIDATION",
            "TEST"
          ],
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "athlete_id",
        "session_external_id",
        "split"
      ],
      "title": "DatasetSplitAssignment",
      "type": "object"
    },
    "DatasetSplitManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "manifest_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Manifest Id",
          "type": "string"
        },
        "assignments": {
          "items": {
            "$ref": "#/$defs/DatasetSplitAssignment"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Assignments",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "manifest_id",
        "assignments"
      ],
      "title": "DatasetSplitManifest",
      "type": "object"
    },
    "ResponseCohortMember": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "POLAR",
          "title": "Provider",
          "type": "string"
        },
        "athlete_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Athlete Id",
          "type": "string"
        },
        "session_external_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Session External Id",
          "type": "string"
        },
        "route_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Route Date",
          "type": "string"
        },
        "replay_snapshot_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Replay Snapshot Id",
          "type": "string"
        },
        "expected_snapshot_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Snapshot Hash",
          "type": "string"
        },
        "expected_evidence_set_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Expected Evidence Set Id",
          "type": "string"
        },
        "expected_evidence_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Evidence Hash",
          "type": "string"
        },
        "expected_unassigned_replay_package_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Unassigned Replay Package Hash",
          "type": "string"
        },
        "expected_dataset_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Expected Dataset Version",
          "type": "string"
        },
        "expected_snapshot_schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Expected Snapshot Schema Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "athlete_id",
        "session_external_id",
        "route_date",
        "replay_snapshot_id",
        "expected_snapshot_hash",
        "expected_evidence_set_id",
        "expected_evidence_hash",
        "expected_unassigned_replay_package_hash"
      ],
      "title": "ResponseCohortMember",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "manifest_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Manifest Id",
      "type": "string"
    },
    "task": {
      "const": "RETROSPECTIVE_HR_RESPONSE_WITHIN_ATHLETE",
      "default": "RETROSPECTIVE_HR_RESPONSE_WITHIN_ATHLETE",
      "title": "Task",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/ResponseCohortMember"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Members",
      "type": "array"
    },
    "split_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/DatasetSplitManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "manifest_id",
    "members"
  ],
  "title": "ResponseCohortManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "V24.10-A request structure. Cross-member and calendar checks require the Python model; source and chronology checks are future work."
}
